# 社区 API 基础地址（一般无需修改）
BBS_API_BASE=https://gf2-bbs-api.exiliumgf.com

# 登录加密密钥（来自官方社区前端脚本，可能随版本变化；失效时抓包重新获取）
ENCRYPTION_KEY=a86a86^oH$04r6A1

# 后端监听端口
PORT=8787

# 前端构建产物目录（后端会托管它）
WEB_DIST=../web/dist

# 运行时数据目录（token 存这里，已被 gitignore）
DATA_DIR=./data

# ---- 对外暴露时的安全与跨域（可选）----
# API Key：非空时，跨域调用 /api/community、/api/tasks 必须在请求头带 x-api-key（或 query ?api_key=）
# 不配置则放行（向后兼容，无鉴权）
API_KEY=

# 允许的跨域来源（逗号分隔，例如 https://your-blog.pages.dev）；默认仅同源（管理页）可用
CORS_ORIGINS=
